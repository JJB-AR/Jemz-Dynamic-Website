@model IReadOnlyList<CoffeeOrder>
@{
    ViewData["Title"] = "Your orders";
}
<section class="page-heading page-heading-compact">
    <p class="eyebrow">A LITTLE LOOK BACK</p>
    <h1>Your <em>orders.</em></h1>
    <p class="page-lede">Your recent Jemz favorites, all in one place.</p>
</section>
@if (Model.Count == 0)
{
    <section class="empty-state cart-empty"><span aria-hidden="true">♡</span><h2>No orders just yet.</h2><p>Your first Jemz order is only a few sips away.</p><a class="button button-primary" asp-controller="Home" asp-action="Index">Browse the menu</a></section>
}
else
{
    <section class="history-list">
        @foreach (var order in Model)
        {
            <article class="history-card">
                <div class="history-heading"><div><p class="eyebrow">ORDER #@order.Id.ToString("D5") · @order.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</p><h2>@order.FulfillmentType order</h2></div><span class="status-pill">@order.Status</span></div>
                <div class="history-items">@string.Join(" · ", order.Lines.Select(line => $"{line.Quantity} × {line.ItemName}"))</div>
                <div class="history-footer"><span>@order.Lines.Sum(line => line.Quantity) items</span><strong>₱@order.Total.ToString("0.00")</strong></div>
            </article>
        }
    </section>
}
