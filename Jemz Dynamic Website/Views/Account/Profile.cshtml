@model ProfileViewModel
@{
    ViewData["Title"] = "Your account";
}
<section class="page-heading page-heading-compact">
    <p class="eyebrow">YOUR COFFEE CORNER</p>
    <h1>Account <em>details.</em></h1>
    <p class="page-lede">Keep your contact details up to date for a smoother order.</p>
</section>
<section class="form-panel profile-panel">
    <form asp-action="Profile" method="post" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="form-field"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /></div>
        <div class="form-field"><label asp-for="Email"></label><input asp-for="Email" type="email" readonly aria-describedby="email-note" /><span id="email-note" class="field-hint">Email changes need help from the shop team.</span></div>
        <div class="form-field"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" type="tel" autocomplete="tel" /></div>
        <button class="button button-primary" type="submit">Save changes <span aria-hidden="true">→</span></button>
    </form>
</section>
