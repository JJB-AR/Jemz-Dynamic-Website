@model IReadOnlyList<MenuItem>
@{
    ViewData["Title"] = "Manage menu";
}
<section class="admin-heading">
    <div><p class="eyebrow">SHOP CONTENT</p><h1>Menu <em>management.</em></h1><p>Update the drinks and treats customers can order.</p></div>
    <div class="admin-actions"><a class="button button-outline" asp-action="Index">Dashboard</a><a class="button button-primary" asp-action="NewMenuItem">Add menu item <span aria-hidden="true">＋</span></a></div>
</section>
<section class="admin-section admin-menu-list">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><h2>Your menu is empty.</h2><p>Add an item to get the menu started.</p><a class="button button-primary" asp-action="NewMenuItem">Add menu item</a></div>
    }
    else
    {
        <div class="table-wrap"><table class="data-table"><thead><tr><th scope="col">Item</th><th scope="col">Category</th><th scope="col">Price</th><th scope="col">Availability</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead><tbody>
        @foreach (var item in Model)
        {
            <tr><td><div class="admin-item-cell"><span aria-hidden="true">@item.Icon</span><span><strong>@item.Name</strong><small>@item.Description</small></span></div></td><td>@item.Category</td><td>₱@item.Price.ToString("0.00")</td><td><span class="status-pill @(item.IsAvailable ? "status-active" : "status-inactive")">@(item.IsAvailable ? "Available" : "Hidden")</span></td><td class="table-action-group"><a class="text-button" asp-action="EditMenuItem" asp-route-id="@item.Id">Edit</a><form asp-action="ToggleMenuItem" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="text-button @(item.IsAvailable ? "text-danger" : "text-positive")" type="submit">@(item.IsAvailable ? "Hide" : "Show")</button></form></td></tr>
        }
        </tbody></table></div>
    }
</section>
